# Copier ce fichier en .env sur le PC de Robert.
# Ne jamais ajouter le vrai .env à GitHub.

JARVIS_USER_NAME=Robert
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_LOG_LEVEL=INFO
JARVIS_RUNTIME_DIR=./runtime

# Sortie vocale uniquement : aucun microphone n'est nécessaire.
JARVIS_SPEECH_ENABLED=true
JARVIS_SPEECH_REPEAT_COOLDOWN_SECONDS=300

# Les clés de fournisseurs IA / mail seront ajoutées ici plus tard,
# uniquement dans le fichier .env local.
