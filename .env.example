# Copier ce fichier en .env uniquement en mode developpeur.
# L'installateur EXE le place automatiquement dans %LOCALAPPDATA%\JarvisPapa\.env.
# Ne jamais ajouter le vrai .env a GitHub.

JARVIS_USER_NAME=Robert
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_LOG_LEVEL=INFO
# Ne pas forcer JARVIS_RUNTIME_DIR ici :
# - depuis les sources, Jarvis utilise ./runtime ;
# - une application EXE installee utilise %LOCALAPPDATA%\JarvisPapa\runtime.

# Sortie vocale uniquement : aucun microphone n'est necessaire.
JARVIS_SPEECH_ENABLED=true
JARVIS_SPEECH_REPEAT_COOLDOWN_SECONDS=300

# Ordre de secours automatique : meilleure qualite -> local -> voix Windows en dernier recours.
JARVIS_VOICE_PROVIDER_ORDER=elevenlabs,azure,qwen3,windows
# Les contenus sensibles restent locaux par defaut.
JARVIS_VOICE_SENSITIVE_PROVIDER_ORDER=qwen3,windows
JARVIS_VOICE_CLOUD_FOR_SENSITIVE_CONTENT=false
JARVIS_VOICE_SPEED=0.95
JARVIS_VOICE_HTTP_TIMEOUT_SECONDS=30
JARVIS_VOICE_CACHE_FILES=40
JARVIS_VOICE_WINDOWS_FALLBACK_ENABLED=true

# 1) ElevenLabs : qualite maximale. Renseigner ces valeurs uniquement dans le .env local.
JARVIS_ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=
JARVIS_ELEVENLABS_MODEL=eleven_v3
JARVIS_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
JARVIS_ELEVENLABS_STABILITY=0.45
JARVIS_ELEVENLABS_SIMILARITY_BOOST=0.78
JARVIS_ELEVENLABS_STYLE=0.22

# 2) Azure Speech : excellent compromis. Vivienne est une voix francaise feminine multilingue.
JARVIS_AZURE_SPEECH_KEY=
JARVIS_AZURE_SPEECH_REGION=
JARVIS_AZURE_SPEECH_ENDPOINT=
JARVIS_AZURE_VOICE_NAME=fr-FR-VivienneMultilingualNeural
JARVIS_AZURE_VOICE_STYLE=
JARVIS_AZURE_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3

# 3) Qwen3-TTS : voix locale hors-ligne.
# Le chemin Python n'est volontairement pas fixe ici : Jarvis choisit le bon emplacement
# selon qu'il tourne depuis les sources ou depuis l'application Windows installee.
JARVIS_QWEN3_TTS_ENABLED=true
JARVIS_QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
JARVIS_QWEN3_TTS_LANGUAGE=French
JARVIS_QWEN3_TTS_SPEAKER=Serena
JARVIS_QWEN3_TTS_DEVICE=cuda:0
JARVIS_QWEN3_TTS_TIMEOUT_SECONDS=180
JARVIS_QWEN3_TTS_WORKER_PORT=8766
JARVIS_QWEN3_TTS_STARTUP_TIMEOUT_SECONDS=180
JARVIS_QWEN3_TTS_IDLE_TIMEOUT_SECONDS=900
JARVIS_QWEN3_TTS_PREWARM=true
# L'instruction par defaut est integree au code : jeune femme francaise, douce et naturelle.

# IA locale Ollama : aucune cle cloud n'est necessaire.
JARVIS_AI_ENABLED=true
JARVIS_AI_PROVIDER=ollama
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen3:4b
JARVIS_AI_TIMEOUT_SECONDS=25
JARVIS_AI_TEMPERATURE=0.2

# Navigateur agentique Playwright.
JARVIS_BROWSER_TIMEOUT_SECONDS=20
JARVIS_BROWSER_MAX_TEXT_CHARS=12000
